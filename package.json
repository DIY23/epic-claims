{
  "name": "epic-claims",
  "version": "1.0.4",
  "private": true,
  "description": "Autonomous Epic Games Store free-game claimer for macOS",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "epic-claims": "dist/cli/index.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "node scripts/build-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:dashboard": "node scripts/build-web.mjs --watch",
    "start": "node dist/cli/index.js serve",
    "native": "bash native/build-helper.sh",
    "package": "bash scripts/package-release.sh"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "commander": "^13.1.0",
    "fastify": "^5.2.1",
    "playwright-core": "^1.50.1",
    "tar": "^7.4.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "esbuild": "^0.24.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.28.2": true
  }
}
